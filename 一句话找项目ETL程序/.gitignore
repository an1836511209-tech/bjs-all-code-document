# 北交所数据ETL系统 .gitignore
# 私有仓库 - 配置文件均纳入版本控制

# Python缓存文件
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
env/
ENV/
.venv

# 日志文件
logs/
*.log

# IDE文件
.vscode/
.idea/
*.swp
*.swo
*~

# 临时文件
tmp/
temp/
*.tmp
*.bak

# 系统文件
.DS_Store
Thumbs.db

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 构建文件
build/
dist/
*.egg-info/

# Jupyter Notebook
.ipynb_checkpoints

.codegraph/
