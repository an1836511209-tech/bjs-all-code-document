{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tool": "search_company_web",
  "description": "按企业全称调用智谱网页搜索，返回标题、链接和摘要。不返回供应商原始响应。",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["company_name"],
    "properties": {
      "company_name": {
        "type": "string",
        "minLength": 1,
        "description": "标的企业全称。"
      },
      "search_keywords": {
        "description": "可选补充检索词。传入后不再使用默认主营业务/行业/上市模板。",
        "oneOf": [
          {"type": "string", "minLength": 1},
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {"type": "string", "minLength": 1}
          }
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["schema_version", "tool", "status", "summary", "data", "sources", "warnings"],
    "properties": {
      "schema_version": {"const": "1.0"},
      "tool": {"const": "search_company_web"},
      "status": {"enum": ["success", "partial", "empty", "failed"]},
      "summary": {"type": "string"},
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "company_name": {"type": "string"},
          "searches": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["query", "results"],
              "properties": {
                "query": {"type": "string"},
                "results": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "title": {"type": "string"},
                      "url": {"type": "string"},
                      "summary": {"type": "string"},
                      "site_name": {"type": "string"}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
      "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
    },
    "$defs": {
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {"name": {"type": "string"}, "status": {"type": "string"}}
      },
      "warning": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message", "retryable"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "retryable": {"type": "boolean"}
        }
      }
    }
  }
}
