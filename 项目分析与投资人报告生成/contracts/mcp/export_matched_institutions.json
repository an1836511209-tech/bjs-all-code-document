{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tool": "export_matched_institutions",
  "description": "独立导出 DMP 首批最多200家投资机构，不进入报告工具面。",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "track_tags"
    ],
    "properties": {
      "track_tags": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 1610
          },
          {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          }
        ]
      }
    }
  },
  "output_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "tool",
      "status",
      "summary",
      "data",
      "sources",
      "warnings"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "tool": {
        "const": "export_matched_institutions"
      },
      "status": {
        "enum": [
          "success",
          "partial",
          "empty",
          "failed"
        ]
      },
      "summary": {
        "type": "string",
        "maxLength": 300
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filename": {
            "const": "投资机构匹配.xlsx"
          },
          "content_base64": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2796204
          },
          "row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "query_tags": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "unverified_row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "count_mismatch_row_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          }
        }
      },
      "sources": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "status"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 100
            },
            "status": {
              "type": "string",
              "maxLength": 100
            }
          }
        }
      },
      "warnings": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "maxLength": 100
            },
            "message": {
              "type": "string",
              "maxLength": 300
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "success",
                "partial",
                "empty"
              ]
            }
          }
        },
        "then": {
          "properties": {
            "data": {
              "required": [
                "filename",
                "content_base64",
                "row_count",
                "sha256",
                "query_tags",
                "unverified_row_count",
                "count_mismatch_row_count"
              ]
            }
          }
        }
      }
    ]
  }
}
