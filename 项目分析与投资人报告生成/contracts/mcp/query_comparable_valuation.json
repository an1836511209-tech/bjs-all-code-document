{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "tool": "query_comparable_valuation",
  "description": "查询历史成交可比估值，向 Agent 返回精简的统一外壳。",
  "input_schema": {
    "type": "object", "additionalProperties": false, "required": ["tags"],
    "properties": {
      "tags": {"oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]},
      "company_name": {"type": "string"}
    }
  },
  "output_schema": {
    "type": "object", "additionalProperties": false,
    "required": ["schema_version", "tool", "status", "summary", "data", "sources", "warnings"],
    "properties": {
      "schema_version": {"const": "1.0"}, "tool": {"const": "query_comparable_valuation"},
      "status": {"enum": ["success", "partial", "empty", "failed"]}, "summary": {"type": "string"},
      "data": {"type": "object", "additionalProperties": false, "properties": {"content": {"type": "string"}}},
      "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
      "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
    },
    "$defs": {
      "source": {"type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"type": "string"}}},
      "warning": {"type": "object", "additionalProperties": false, "required": ["code", "message", "retryable"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "retryable": {"type": "boolean"}}}
    }
  }
}
