ARG UV_VERSION=0.7.20

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv

FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_HTTP_TIMEOUT=30000 \
    UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple/

# 替换 Debian 官方源为阿里云镜像，加速 apt 安装
RUN sed -i \
        -e 's|deb.debian.org|mirrors.aliyun.com|g' \
        -e 's|security.debian.org|mirrors.aliyun.com|g' \
        /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install --yes --no-install-recommends \
        -o Acquire::Retries=5 \
        -o Acquire::http::Timeout=120 \
        bash \
        bubblewrap \
        ca-certificates \
        coreutils \
        findutils \
        git \
        grep \
        jq \
        libreoffice-calc \
        libreoffice-impress \
        libreoffice-writer \
        fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && chmod 4755 /usr/bin/bwrap \
    && groupadd --gid 10001 report-agent \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash report-agent

COPY --from=uv /uv /uvx /bin/

WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY apps/data_mcp/pyproject.toml apps/data_mcp/README.md ./apps/data_mcp/
COPY apps/report_agent ./apps/report_agent
COPY contracts ./contracts
COPY deploy/environments ./deploy/environments
# Run Console 的静态资源。容器根文件系统是只读的（compose: read_only），
# 所以必须打进镜像；缺这一层 /console/ 会 404。
COPY frontend ./frontend
COPY resources ./resources

RUN --mount=type=cache,target=/root/.cache/uv \
    sed -i 's|https://files.pythonhosted.org/packages|https://mirrors.aliyun.com/pypi/packages|g' uv.lock \
    && uv sync --frozen --package bjs-report-agent --no-dev --no-editable \
    && /app/.venv/bin/python -c "from report_agent.infrastructure.word.one_pager_authoring import resolve_template; from report_agent.domain.one_pager import BusinessType; [resolve_template(kind) for kind in BusinessType]" \
    && mkdir -p /var/lib/report-agent/workspaces /workspace \
    && chown -R report-agent:report-agent /var/lib/report-agent /workspace

ENV PATH="/app/.venv/bin:${PATH}"
USER report-agent

EXPOSE 8000

CMD ["report-agent-spike", "--workspace-root", "/var/lib/report-agent/workspaces"]
